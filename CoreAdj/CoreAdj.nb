  CellTags->"XRef-Equation-121162956"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(\(\[ScriptCapitalX](Y, U\ A)\)\[CircleTimes]\(\[ScriptCapitalX](
                X, Y)\)\), \(\[LongRightArrow]\&\(\(\[Pi]\^\(-1\)\
\[CircleTimes]F\_\(X\ Y\)\)\(\ \ \)\)\), \(\(\[ScriptCapitalA](F\ Y, 
                A)\)\[CircleTimes]\(\[ScriptCapitalA](F\ X, F\ Y)\)\)},
