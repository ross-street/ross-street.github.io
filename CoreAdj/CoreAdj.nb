Cell[TextData[{
  Cell[TextData[{
    "A",
    StyleBox["BSTRACT", "SmallCaps"],
    ". "
  }], "Nil",
    TaggingRules:>{"CellLabel" -> True}],
  "There is a lot of redundancy in the usual definition of adjoint functors. \
We define and prove the core of what is required.   "
}], "Abstract"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["B O D Y", "MainmatterGroup"],

Cell[TextData[{
  "Kan ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[1]",
    ButtonData:>"KanAdjFun",
    ButtonStyle->"Citation",
    ButtonNote->"KanAdjFun"],
  " introduced the notion of adjoint functors. By defining the unit and \
counit natural transformations, he paved the way for the notion to be \
internalized to any 2-category. This was done by Kelly ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[2]",
    ButtonData:>"Kelly1969",
    ButtonStyle->"Citation",
    ButtonNote->"Kelly1969"],
  " whose interest at the time was particularly in the 2-category of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-categories for a monoidal category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  " (in the sense of Eilenberg-Kelly ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[3]",
    ButtonData:>"EilKel1966",
    ButtonStyle->"Citation",
    ButtonNote->"EilKel1966"],
  "). "
}], "Text",
  CellTags->{":bib:EilKel1966", ":bib:KanAdjFun", ":bib:Kelly1969"}],

Cell["", "TextContinuation"],

Cell[TextData[{
  "For ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-categories ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalA]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalX]\)]],
  ", an ",
  StyleBox["adjunction",
    FontSlant->"Italic"],
  " consists of"
}], "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-functors ",
  Cell[BoxData[
      \(TraditionalForm\`U : \[ScriptCapitalA]\[LongRightArrow]\
\[ScriptCapitalX]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`F : \[ScriptCapitalX]\[LongRightArrow]\
\[ScriptCapitalA]\)]],
  ";"
}], "Item1Numbered",
  CounterAssignments->{{"Item1Numbered", 0}}],

Cell[TextData[{
  "a ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-natural family of isomorphisms ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi] : \[ScriptCapitalA](F\ X, 
            A) \[TildeFullEqual] \[ScriptCapitalX](X, U\ A)\)]],
