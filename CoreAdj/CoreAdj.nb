Cell["", "TextContinuation"],

Cell[TextData[{
  StyleBox["Proof",
    FontSlant->"Italic"],
  " We deal first with the version involving diagram (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  "\[InvisibleSpace]). For an adjunction, (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  "\[InvisibleSpace]) expresses the ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-naturality of ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`A \[Element] \[ScriptCapitalA]\)]],
  ". Conversely, given an adjunction core satisfying (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  "\[InvisibleSpace]), we paste to the left of (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  StyleBox[")", "Nil"],
  "\[InvisibleSpace] with ",
  Cell[BoxData[
      \(TraditionalForm\`X\  = U\ C\)]],
  ", the diagram "
}], "TextContinuation"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(\(\[ScriptCapitalA](A, B)\)\[CircleTimes]\(\[ScriptCapitalA](C, 
                A)\)\), \(\[LongRightArrow]\&\(\(1\)\(\[CircleTimes]\)\(\
\[ScriptCapitalA](\[CurlyEpsilon]\_C, 1)\)\(\ \ \)\)\), \(\(\[ScriptCapitalA](
                A, B)\)\[CircleTimes]\(\[ScriptCapitalA](F\ U\ C, A)\)\)},
          {
            RowBox[{
              RowBox[{"\[InvisiblePrefixScriptBase]", 
