\[CurlyEpsilon]\_C, 1)\)\(\ \ \)\)\), \(\[ScriptCapitalA](F\ U\ C, B)\)}
          }], TraditionalForm]], "EquationNumbered"],

Cell["\<\
which commutes by naturality of composition. This leads to the \
following commutative square.\
\>", "TextContinuation"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(\(\[ScriptCapitalA](A, B)\)\[CircleTimes]\(\[ScriptCapitalA](C, 
                A)\)\), \(\[LongRightArrow]\&\(\(U\)\(\[CircleTimes]\)\(U\)\(\
\ \ \)\)\), \(\(\[ScriptCapitalX](U\ A, 
                U\ B)\)\[CircleTimes]\(\[ScriptCapitalX](U\ C, U\ A)\)\)},
          {
            RowBox[{
              RowBox[{"\[InvisiblePrefixScriptBase]", 
                SuperscriptBox["\[InvisiblePrefixScriptBase]", 
                  StyleBox["comp",
                    FontSlant->"Italic"]]}], "\[DownArrow]"}], "=", 
            SuperscriptBox["\[DownArrow]", 
              StyleBox["comp",
                FontSlant->"Italic"]]},
          {\(\[ScriptCapitalA](C, 
              B)\), \(\[LongRightArrow]\+\(\(\ \ \)\(U\)\(\ \ \)\)\), \(\
\[ScriptCapitalX](U\ C, U\ B)\)}
          }], TraditionalForm]], "EquationNumbered",
  CellTags->"XRef-Equation-121172723"],

Cell["We also have the equality", "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\((I\(\[LongRightArrow]\&j\)\(\[ScriptCapitalA](A, 
            A)\)\(\[LongRightArrow]\&U\)\(\[ScriptCapitalX](U\ A, 
            U\ B)\))\) = \((I\(\[LongRightArrow]\&j\)\(\[ScriptCapitalX](
            U\ A, U\ B)\))\)\)], "EquationNumbered",
  CellTags->"XRef-Equation-121172748"],

Cell[TextData[{
  "straight from the definitions (b) and (c). Together (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121172723"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121172723"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121172723"], "Nil"],
  "\[InvisibleSpace]) and (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121172748"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121172748"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121172748"], "Nil"],
  "\[InvisibleSpace]) tell us that ",
  Cell[BoxData[
      \(TraditionalForm\`U\)]],
  " is a ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-functor. Now the general diagram (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  "\[InvisibleSpace]) expresses the ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-naturality of ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  ". By ",
  "Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-121173012"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-121173012"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-121173012"], "Nil"],
  "\[InvisibleSpace], we have an adjunction determined uniquely by the core."
}], "TextContinuation"],

Cell[TextData[{
  "Writing ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\^rev\)]],
  " for ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  " with the reversed monoidal structure ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[CircleTimes]\^rev\)B = B\[CircleTimes]A\)]],
  ", and applying the first part of this proof to the ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\^rev\)]],
  "-enriched adjunction ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\^\(-1\)\) : 
        U\^op \[LeftTee] \(\(F\^op\) : \[ScriptCapitalX]\^op\[LongRightArrow]\
\[ScriptCapitalA]\^op\)\)]],
  ", which is the same as an adjunction ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi] : 
        F \[LeftTee] \(U : \
\[ScriptCapitalA]\[LongRightArrow]\[ScriptCapitalX]\)\)]],
  ", we see that it is equivalent to an adjunction core satisfying (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121163025"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121163025"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121163025"], "Nil"],
  "\[InvisibleSpace]).  ",
  StyleBox["\[EmptySquare]", "QED"]
}], "Text"],

Cell["", "TextContinuation"],

Cell[TextData[{
  Cell[TextData[{
    "Corollary ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "CorollaryLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  " is a poset then adjunction cores are adjunctions."
}], "Corollary",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem"],

Cell["", "TextContinuation"],

Cell[TextData[{
  StyleBox["Proof",
    FontSlant->"Italic"],
  " All diagrams, including (",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-121162956"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-121162956"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-121162956"], "Nil"],
  "\[InvisibleSpace]), commute in such a ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  ".  ",
  StyleBox["\[EmptySquare]", "QED"]
}], "TextContinuation"]
}, Open  ]],

