Cell["Given such a core, we make the following definitions:", "Text"],

Cell[TextData[{
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Eta]\_X\) : X\[LongRightArrow]U\ F\ X\)]],
  " is the composite"
}], "Item2Numbered",
  CounterAssignments->{{"Item2Numbered", 0}}],

Cell[BoxData[
    \(TraditionalForm\`\(I\(\[LongRightArrow]\&j\)\(\[ScriptCapitalA](F\ X, 
          F\ X)\)\)\(\[LongRightArrow]\&\[Pi]\)\(\[ScriptCapitalX](X, 
        U\ F\ X)\); \)], "Equation"],

Cell[TextData[{
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CurlyEpsilon]\_A\) : 
        F\ U\ A\[LongRightArrow]A\)]],
  " is the composite"
}], "Item2Numbered"],

Cell[BoxData[
    \(TraditionalForm\`\(I\(\[LongRightArrow]\&j\)\(\[ScriptCapitalX](U\ A, 
          U\ A)\)\)\(\[LongRightArrow]\&\(\[Pi]\^\(-1\)\)\)\(\[ScriptCapitalA]\
(F\ U\ A, X)\); \)], "Equation"],

Cell[TextData[{
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\(U\_\(A\ B\)\) : \(\[ScriptCapitalA](A, 
