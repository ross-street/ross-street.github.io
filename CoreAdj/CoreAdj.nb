    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`U : \[ScriptCapitalA]\[LongRightArrow]\
\[ScriptCapitalX]\)]],
  " is a ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-functor, ",
  Cell[BoxData[
      FormBox[
        RowBox[{"F", ":", 
          RowBox[{
            StyleBox[
              RowBox[{
                StyleBox["ob",
                  FontSlant->"Italic"], "\[ScriptCapitalX]"}]], 
            "\[LongRightArrow]", 
            StyleBox[
              RowBox[{
                StyleBox["ob",
                  FontSlant->"Italic"], "\[ScriptCapitalA]"}]]}]}], 
        TraditionalForm]]],
  " is a function, and, for each ",
  Cell[BoxData[
      \(TraditionalForm\`X \[Element] \[ScriptCapitalX]\)]],
  ", ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi] : \[ScriptCapitalA](F\ X, 
            A) \[TildeFullEqual] \[ScriptCapitalX](X, U\ A)\)]],
  " is a family of isomorphisms ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalV]\)]],
  "-natural in ",
  Cell[BoxData[
      \(TraditionalForm\`A \[Element] \[ScriptCapitalA]\)]],
  ". Then there exists a unique adjunction ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi] : 
        F \[LeftTee] \(U : \
\[ScriptCapitalA]\[LongRightArrow]\[ScriptCapitalX]\)\)]],
  " for which ",
  Cell[BoxData[
      \(TraditionalForm\`F : 
        ob\[ScriptCapitalX]\[LongRightArrow]ob\[ScriptCapitalA]\)]],
