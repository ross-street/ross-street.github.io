Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " A functor ",
  Cell[BoxData[
      \(TraditionalForm\`Q : \[ScriptCapitalB] \[Rule] \[ScriptCapitalA]\)]],
  " is right adjoint to a functor ",
  Cell[BoxData[
      \(TraditionalForm\`P : \[ScriptCapitalA] \[Rule] \[ScriptCapitalB]\)]],
  " when ",
  Cell[BoxData[
