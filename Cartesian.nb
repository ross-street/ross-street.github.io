                Y\( \[Rule] \&g\)E)\)}]}], ")"}]}], 
      TraditionalForm]], "EquationNumbered",
  CellTags->"XRef-Equation-518182330"],

Cell[TextData[{
  "is a bijection. Put ",
  Cell[BoxData[
