\[InvisiblePrefixScriptBase]\^pr\_2\)\)}
                  }], "=", GridBox[{
                  {
                    SuperscriptBox["\[DownArrow]", 
                      StyleBox[\(\[InvisiblePrefixScriptBase]\^d\_0\),
                        
                        Editable->
                          True]], \(\[DownArrow]\^\(\
\[InvisiblePrefixScriptBase]\^d\_1\)\)}
                  }]},
            {"R", \(\[LongRightArrow]\+y\), \(E\_0\)}
            }], "  ", "."}], TraditionalForm]], "EquationNumbered",
  CellTags->"XRef-Equation-5917492"],

Cell[TextData[{
  "For all 2-cells ",
  Cell[BoxData[
      \(TraditionalForm\`\[Xi] : e \[Implies] \(\(e\^\[Prime]\) : X\) \[Rule] 
        E\)]],
  " and all ",
  Cell[BoxData[
      \(TraditionalForm\`r : X \[Rule] R\)]],
  ", we have that the composite "
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`e = \(\(\(pr\_1\)(e, 
              r)\)\(\[LongRightArrow]\&\(\[Chi]\ \((e, \ 
                    r)\)\)\)y\ \(\(pr\_2\)(e, 
            r)\) = \(y\ r\(\[LongRightArrow]\&\(j\ \(\(pr\_2\)(\[Xi], 1)\) = 
                    1\)\)y\ \(\(pr\_2\)(e\^\[Prime], r)\) = 
          y\ r\)\)\)], "Equation"],

Cell["is equal to the composite", "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`e = \(\(\(pr\_1\)(e, 
            r)\)\(\[LongRightArrow]\&\(\[Xi] = \ \(pr\_2\)(\[Xi], 
                  1)\)\)e\^\[Prime] = \(\(\(pr\_1\)(e\^\[Prime], 
                r)\)\(\[LongRightArrow]\&\(\[Chi]\ \((e\^\[Prime], \ 
                      r)\)\)\)y\ \(\(pr\_2\)(e\^\[Prime], r)\) = 
          y\ \(\(r\)\(\ \)\(.\)\)\)\)\)], "Equation"],

Cell[TextData[{
  "This gives ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi](y\ r, 
          t) = \(\[Chi](y\ s, t)\) \(\[Chi](y\ r, s)\)\)]],
  " which, together with ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi](y, 1) = 1\)]],
  ", means that ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " is a functor. It also implies that ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi]\)]],
  " extends to a 2-cell"
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\[Chi] : 
      pr\_1\[DoubleLongRightArrow]j\ \(\(pr\_2\) : \(\(E\[Cross]
              R\_c\[LongRightArrow]E\)\(\ \)\(.\)\)\)\)], "EquationNumbered"],

Cell["Define", "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\(\[CapitalTheta]\_R\)(p) = 
      p\ \(j : \(\(R\_c\[LongRightArrow]
              B\)\(\ \)\(.\)\)\)\)], "EquationNumbered"],

Cell[TextData[{
  "For any morphism ",
  Cell[BoxData[
      \(TraditionalForm\`w : E \[Rule] E\^\[Prime]\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`Tors(R, B)\)]],
  ", construct ",
  Cell[BoxData[
      \(TraditionalForm\`j\^\[Prime]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi]\^\[Prime]\)]],
  " from ",
  Cell[BoxData[
      \(TraditionalForm\`E\^\[Prime]\)]],
  " just as we constructed ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi]\)]],
  " from ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  ". Define"
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\[CapitalTheta]\_R\)(w) : 
      p\ j\[DoubleLongRightArrow]p\^\[Prime]\ \(\(j\^\[Prime]\) : 
          R\_c\[LongRightArrow]B\)\)], "Equation"],

Cell["to be the 2-cell", "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`p\ j = \(\(p\^\[Prime]\) \(\(pr\_1\)(w\ j, 
              1)\)\(\[DoubleLongRightArrow]\&\(\(\ \)\(\(p\^\[Prime]\) \(\(\
\[Chi]\^\[Prime]\)(w\ j, 1)\)\)\)\)p\^\[Prime] 
           j\^\[Prime]\ \(\(pr\_2\)(w\ j, 
            1)\) = \(p\^\[Prime]\) \(\(j\^\[Prime]\)\(.\)\)\)\)], "Equation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is cartesian closed and ",
  Cell[BoxData[
      \(TraditionalForm\`R \[Rule] 1\)]],
  " is a regular epimorphism in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". If ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " is a discrete fibration which is representable over ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  " then the morphism ",
  Cell[BoxData[
      \(TraditionalForm\`j : R\_c \[Rule] E\)]],
  " defined in ",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-5917492"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-5917492"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-5917492"], "Nil"],
  StyleBox[" is final.", "Nil"],
  "\[InvisibleSpace]"
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-511132949"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Take a discrete opfibration ",
  Cell[BoxData[
      \(TraditionalForm\`q : F \[Rule] E\)]],
  " (not necessarily powerful) and form the pullback"
}], "TextContinuation"],

Cell[BoxData[
    FormBox[
      RowBox[{GridBox[{
            {"P", \(\[LongRightArrow]\&g\), "F"},
            {\(\(\[InvisiblePrefixScriptBase]\^h\)\[DownArrow]\), 
              "=", \(\[DownArrow]\^q\)},
            {\(R\_c\), \(\[LongRightArrow]\+j\), "E"}
            }], " ", "."}], TraditionalForm]], "Equation"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[Phi] : pr\_1 \[Implies] w\)]],
  " be the unique 2-cell with"
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`q\ \[Phi] = \(\[Chi]\ \((q\[Cross]1\_\(R\_c\))\) : 
          q\ pr\_1 = \(\(\(pr\_1\)(
                q\[Cross]1\_\(R\_c\))\)\[DoubleLongRightArrow]j\ \(\(pr\_2\)(
              q\[Cross]1\_\(R\_c\))\) = q\ \(\(w\)\(.\)\)\)\)\)], "Equation"],

Cell[TextData[{
  "From the pullback property, there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`u : F\[Cross]R\_c \[Rule] P\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`h\ u = pr\_2\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`g\ u = w\)]],
  ". Since ",
  Cell[BoxData[
      \(TraditionalForm\`R \[Rule] 1\)]],
  " is a regular epimorphism, we have the coequalizer"
}], "TextContinuation"],

Cell[BoxData[
    FormBox[
      RowBox[{
        RowBox[{\(R\[Cross]R\), GridBox[{
              {\(\[LongRightArrow]\&\(pr\_1\)\)},
              {\(\[LongRightArrow]\+\(pr\_2\)\)}
              }], \(R\[LongRightArrow]1\)}], " ", ";"}], 
      TraditionalForm]], "Equation"],

Cell[TextData[{
  "so ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(R\_c) \[TildeFullEqual] 1\)]],
  ". By ",
  "Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-5918542"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-5918542"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-5918542"], "Nil"],
  "\[InvisibleSpace], "
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\(\[Pi]\_0\)(
        pr\_1) : \(\[Pi]\_0\)(
          F\[Cross]R\_c) \[TildeFullEqual] \(\(\[Pi]\_0\)(
            F)\)\[Cross]\(\(\[Pi]\_0\)(R\_c)\)\[LongRightArrow]\(\(\[Pi]\_0\)(
              F)\)\)], "Equation"],

Cell[TextData[{
  "is invertible. Since we have ",
  Cell[BoxData[
      \(TraditionalForm\`\[Phi] : pr\_1 \[Implies] w\)]],
  ", it follows that ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(w)\)]],
  " is invertible. Notice that  "
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\(q\ \[Phi]\ \((g, 
            h)\) = \(\[Chi]\ \((q\[Cross]1)\)\ \((g, 
              h)\) = \(\[Chi]\ \((q\ g, h)\) = \(\[Chi]\ \((j\ h, h)\)\  = 
              1\)\)\);\)\)], "Equation"],

Cell[TextData[{
  "so there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`\[Beta] : 1\_P \[Implies] u\ \((g, h)\)\)]],
  " such that ",
  Cell[BoxData[
      \(TraditionalForm\`h\ \[Beta] = 1\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`g\ \[Beta] = \[Phi]\ \((g, h)\)\)]],
  ". So ",
  Cell[BoxData[
      \(TraditionalForm\`1 = \(\(\[Pi]\_0\)(u)\)\ \(\(\[Pi]\_0\)(g, h)\)\)]],
  ". So ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(u)\)]],
  " is a retraction. But ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\[Pi]\_0\)(g)\) \(\(\[Pi]\_0\)(
            u)\) = \(\[Pi]\_0\)(w)\)]],
  " is invertible. So ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(g)\)]],
  " is invertible, as required",
  ".       ",
  StyleBox["\[EmptySquare]", "QED"],
  " "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is a cartesian closed and finitely cocomplete category. Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " is a discrete fibration with ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " amenable and suppose ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  " is an object of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". If there exists a final ",
  Cell[BoxData[
      \(TraditionalForm\`j : R\_c \[Rule] E\)]],
  " then ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " is representable over ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  "; moreover, ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " is unique up to isomorphism."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-511132717"],

Cell[TextData[{
  StyleBox["Proof. ",
    FontSlant->"Italic"],
  "The effect of ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " on objects gives a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`y : R \[Rule] E\)]],
  " and the effect on morphisms gives a 2-cell"
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\[Phi] : 
      j\ pr\_1\[DoubleLongRightArrow]y\ \(\(pr\_2\) : \(\(R\_c\[Cross]
              R\[LongRightArrow]E\)\(\ \)\(.\)\)\)\)], "Equation"],

Cell[TextData[{
  "This last 2-cell induces a functor ",
  Cell[BoxData[
      \(TraditionalForm\`h : R\_c\[Cross]R \[Rule] \((E/y)\)\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`d\_0\ h = j\ pr\_1\)]],
  ", ",
  Cell[BoxData[
      \(TraditionalForm\`d\_1\ h = pr\_2\)]],
  ", and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Lambda]\ h = \[Phi]\)]],
  ". Since ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is cartesian closed, ",
  Cell[BoxData[
      \(TraditionalForm\`R \[Rule] 1\)]],
  " is powerful. So ",
  Cell[BoxData[
      \(TraditionalForm\`\(pr\_1\) : E\[Cross]R \[Rule] E\)]],
  " is a powerful discrete opfibration (using Corollary ",
  ButtonBox[
  CounterBox["Section", "XRef-Corollary-429151819"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Corollary-429151819"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Corollary-429151819"], "Nil"],
  "\[InvisibleSpace](3)). So the top morphism in the following square is \
final."
}], "TextContinuation"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(R\_c\[Cross]
              R\), \(\[LongRightArrow]\&\(j\[Cross]1\)\), \(E\[Cross]R\)},
          {\(\(\[InvisiblePrefixScriptBase]\^h\)\[DownArrow]\), 
            "=", \(\[DownArrow]\^pr\_1\)},
          {\((E/y)\), \(\[LongRightArrow]\+\(d\_0\)\), "E"}
          }], TraditionalForm]], "Equation"],

Cell[TextData[{
  "Since ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " is amenable, so too is ",
  Cell[BoxData[
      \(TraditionalForm\`E\[Cross]R\)]],
  ". By Theorem ",
  ButtonBox[
  CounterBox["Section", "XRef-Theorem-510174817"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Theorem-510174817"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Theorem-510174817"], "Nil"],
  "\[InvisibleSpace](2), there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`x : E\[Cross]R \[Rule] \((E/j)\)\)]],
  " such that ",
  Cell[BoxData[
      \(TraditionalForm\`x\ \((j\[Cross]1)\) = h\)]],
  " and ",
  Cell[BoxData[
