Cell[CellGroupData[{

Cell["Cartesian morphisms, pullbacks and ordinal composites", "Title"],

Cell[TextData[Cell[TextData[{
  ButtonBox["Ross",
    ButtonData:>"AuthorFirstName1",
    ButtonStyle->"AuthorFirstName"],
  " ",
  ButtonBox["Street",
    ButtonData:>"AuthorLastName1",
    ButtonStyle->"AuthorLastName"],
  Cell[BoxData[
      FormBox[
        SuperscriptBox["", 
          ButtonBox[
            OverscriptBox["\[EmptySmallSquare]", 
              AdjustmentBox["\[Hacek]",
                BoxMargins->{{0.03125, -0.03125}, {-0.791667, 0.791667}},
                BoxBaselineShift->0.791667]],
