  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    False}}}],

Cell[TextData[{
  "A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`R\_c \[Rule] B\)]],
  " is termed a \[CapitalCHacek]ech cocycle, defined over ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  ", with coefficients in ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  ". "
}], "TextContinuation"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`Tors(R, B)\)]],
  " denote the full subcategory of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^\(B\^op\)\)]],
  " consisting of the objects which are the discrete fibrations in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " representable over ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  ". There is a functor  "
}], "Text"],

Cell[BoxData[
    FormBox[
      RowBox[{"\[CapitalTheta]", "=", 
        RowBox[{\(\[CapitalTheta]\_R\), ":", 
          
          RowBox[{\(\(Tors(R, B)\)\[LongRightArrow]\(\[ScriptCapitalK](R\_c, 
                B)\)\), Cell[""]}]}]}], TraditionalForm]], "EquationNumbered",\

  CellTags->"XRef-Equation-51018811"],

Cell[TextData[{
  "defined as follows. Take a discrete fibration ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " which is representable over ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  ". Let ",
  Cell[BoxData[
      \(TraditionalForm\`y\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[Chi]\)]],
  " be as in Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-59163410"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
