    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-59163410"], "Nil"],
  "\[InvisibleSpace](ii). Let ",
  Cell[BoxData[
      \(TraditionalForm\`j : R\_c \[Rule] E\)]],
  " denote the following morphism of graphs."
}], "TextContinuation"],

Cell[BoxData[
    FormBox[
      RowBox[{GridBox[{
            {\(R\[Cross]
                R\), \(\[LongRightArrow]\&\(\[Chi](
                    y\[Cross]1)\)\), \(E\_1\)},
            {GridBox[{
                  {
                    SuperscriptBox["\[DownArrow]", 
                      StyleBox[\(\[InvisiblePrefixScriptBase]\^pr\_1\),
                        
