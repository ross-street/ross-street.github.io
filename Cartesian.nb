      \(TraditionalForm\`Tors(R, B)\)]],
  ". Then ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CapitalTheta]\_R\)(p) = p\ j\^\[Prime]\)]],
  " for some final ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\ \)\(j\^\[Prime]\)\)\)]],
  " by Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-511132949"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-511132949"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-511132949"], "Nil"],
  "\[InvisibleSpace]. By uniqueness in ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-511132717"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-511132717"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-511132717"], "Nil"],
  ", ",
  Cell[BoxData[
      \(TraditionalForm\`j \[TildeFullEqual] j\^\[Prime]\)]],
  ". So ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CapitalTheta]\_R\)(p) \[TildeFullEqual] p\ j = 
        f\)]],
  ".  "
}], "TextContinuation"],

Cell[TextData[{
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`\[Omega] : \(\[CapitalTheta]\_R\)(
            p) \[Implies] \(\[CapitalTheta]\_R\)(p\^\[Prime])\)]],
  " is a morphism in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK](R\_c, B)\)]],
  ". Let ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CapitalTheta]\_R\)(p) = p\ j\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CapitalTheta]\_R\)(p\^\[Prime]) = 
        p\^\[Prime]\ j\^\[Prime]\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`j\^\[Prime]\)]],
  " are final. Since ",
  Cell[BoxData[
      \(TraditionalForm\`p\^\[Prime]\)]],
  " is a discrete fibration, there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`\[Phi] : u \[Implies] j\^\[Prime]\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`\(p\^\[Prime]\) \[Phi] = \[Omega]\)]],
  ". Since ",
  Cell[BoxData[
      \(TraditionalForm\`p\ j = \(p\^\[Prime]\) u\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " is amenable (by Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-511134216"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-511134216"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
