      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " (in the sense of ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[13]",
    ButtonData:>"St74b",
    ButtonStyle->"Citation",
    ButtonNote->"St74b"],
  ") are representably powerful since they are defined representably, and \
fibrations and opfibrations are powerful in ",
  Cell[BoxData[
      FormBox[
        StyleBox["Cat",
          FontWeight->"Bold"], TraditionalForm]]],
  "."
}], "Text",
  CellTags->":bib:St74b"],

