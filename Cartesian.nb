Cell[CellGroupData[{

Cell["Internal comprehensive factorization", "Section"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " denote a finitely complete and finitely cocomplete category. Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " denote the 2-category ",
  Cell[BoxData[
      \(TraditionalForm\`Cat(\[ScriptCapitalE])\)]],
  " of categories in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". We identify ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " with the sub-2-category of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " consisting of the discrete categories in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". "
}], "Text"],

Cell[TextData[{
  "For each object ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  ", the coequalizer"
}], "Text"],

Cell[BoxData[
    FormBox[
      RowBox[{\(A\_1\), GridBox[{
            {\(\[LongRightArrow]\&\(d\_0\)\)},
            {\(\[LongRightArrow]\+\(d\_1\)\)}
            }], \(A\_0\[LongRightArrow]\(\(\[Pi]\_0\)(A)\)\)}], 
      TraditionalForm]], "EquationNumbered"],

Cell[TextData[{
  "in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " yields a coidentifier (in the sense of ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[15]",
    ButtonData:>"St76",
    ButtonStyle->"Citation",
    ButtonNote->"St76"],
  ")"
}], "TextContinuation",
  CellTags->":bib:St76"],

Cell[BoxData[
    FormBox[
      RowBox[{
        SuperscriptBox["A", 
          StyleBox["2",
            FontWeight->"Bold"]], GridBox[{
            {\(\[LongRightArrow]\&\(d\_0\)\)},
            {\(\[DoubleDownArrow]\^\[Lambda]\)},
            {\(\[LongRightArrow]\+\(d\_1\)\)}
            }], \(A\[LongRightArrow]\(\(\[Pi]\_0\)(A)\)\)}], 
      TraditionalForm]], "EquationNumbered",
  CellTags->"XRef-Equation-59104320"],

Cell[TextData[{
  "in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  ". Then ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\) : \[ScriptCapitalK] \[Rule] \
\[ScriptCapitalE]\)]],
  " is left adjoint to the inclusion 2-functor. This implies that, if there \
is a 2-cell ",
  Cell[BoxData[
      \(TraditionalForm\`f \[DoubleRightArrow] g\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  ", then ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(f) = \(\[Pi]\_0\)(g)\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  "; so that adjoint morphisms in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " are taken by ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\_0\)]],
  " to isomorphisms. "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "Using Day\[CloseCurlyQuote]s Reflection Theorem (see Theorems (3.10) and \
(3.24) of ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  "), we deduce the following."
}], "Text"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is cartesian closed then ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\_0\)]],
  " preserves finite products.        ",
  StyleBox["\[EmptySquare]", "QED"]
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
