Cell["is an isomorphism.", "PropositionContinuation"]
}, Open  ]],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Since ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " is a fibration, the inclusion ",
  Cell[BoxData[
      \(TraditionalForm\`E\ b\[LongRightArrow]\ \((b/p)\)\)]],
  " of the pullback into the comma object has a right adjoint. Since both ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " are discrete, ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(E\ b) = E\ b\)]],
  ".    ",
  StyleBox["\[EmptySquare]", "QED"],
  " "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " is said to be ",
  StyleBox["final",
    FontSlant->"Italic"],
  " when, for all powerful discrete opfibrations ",
  Cell[BoxData[
      \(TraditionalForm\`q : F \[Rule] B\)]],
  ", the projection ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[Cross]\+B\)F \[Rule] F\)]],
  " is inverted by the 2-functor ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\_0\)]],
  "."
}], "Text"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " is final. A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`k : B \[Rule] C\)]],
  " is final if and only if ",
  Cell[BoxData[
      \(TraditionalForm\`k\ j\)]],
  " is final."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-59121453"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " If ",
  Cell[BoxData[
      \(TraditionalForm\`q : F \[Rule] C\)]],
  " is a powerful discrete opfibration, so too is ",
  Cell[BoxData[
      \(TraditionalForm\`B\(\[Cross]\+C\)F \[Rule] \ B\)]],
  " (using Corollary ",
  ButtonBox[
  CounterBox["Section", "XRef-Corollary-429151819"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Corollary-429151819"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Corollary-429151819"], "Nil"],
  "\[InvisibleSpace](3)). Since ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " is final, it follows that ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\)]],
  " inverts ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[Cross]\+C\)F \[Rule] \ B\(\[Cross]\+C\)F\)]],
  ". So ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\_0\)]],
  " inverts ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[Cross]\+C\)F \[Rule] \ \(B\(\[Cross]\+C\)F \
\[Rule] F\)\)]],
  " if and only if it inverts ",
  Cell[BoxData[
      \(TraditionalForm\`B\(\[Cross]\+C\)F \[Rule] F\)]],
  ".   ",
  StyleBox["\[EmptySquare]", "QED"],
  "   "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Right adjoints are final."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-5912153"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " has a left adjoint and ",
  Cell[BoxData[
      \(TraditionalForm\`q : F \[Rule] B\)]],
  " is a (powerful discrete) opfibration. Let ",
  Cell[BoxData[
      \(TraditionalForm\`g : P \[Rule] F\)]],
  " be the pullback of ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " along ",
  Cell[BoxData[
      \(TraditionalForm\`q\)]],
  ". Since ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " has a left adjoint, so too does the projection ",
  Cell[BoxData[
      \(TraditionalForm\`\((q/j)\) \[Rule] F\)]],
  ". Yet ",
  Cell[BoxData[
      \(TraditionalForm\`g\)]],
  " factors through ",
  Cell[BoxData[
      \(TraditionalForm\`\((q/j)\) \[Rule] F\)]],
  " via a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`P \[Rule] \((q/j)\)\)]],
  " which has a left adjoint since ",
  Cell[BoxData[
      \(TraditionalForm\`q\)]],
  " is an opfibration. So ",
  Cell[BoxData[
      \(TraditionalForm\`g\)]],
  " has a left adjoint and hence induces ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\)(P) \[TildeFullEqual] \(\[Pi]\_0\)(
          F)\)]],
  ".      ",
  StyleBox["\[EmptySquare]", "QED"],
  " "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Coidentifiers are final."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-5912158"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " is a coidentifier of some 2-cell and ",
  Cell[BoxData[
      \(TraditionalForm\`q : F \[Rule] B\)]],
  " is a powerful (discrete) opfibration. Then pullback with ",
  Cell[BoxData[
      \(TraditionalForm\`q\)]],
  " has a right adjoint and so preserves coidentifiers. So ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[Cross]\+B\)F \[Rule] F\)]],
  " is a coidentifier in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  ". Since ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Pi]\_0\) : \[ScriptCapitalK] \[Rule] \
\[ScriptCapitalE]\)]],
  " is a left adjoint, it preserves coidentifiers. Yet coidentifiers in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " are invertibe! So ",
  Cell[BoxData[
      \(TraditionalForm\`\[Pi]\)]],
  " inverts ",
  Cell[BoxData[
      \(TraditionalForm\`A\(\[Cross]\+B\)F \[Rule] F\)]],
  ".    ",
  StyleBox["\[EmptySquare]", "QED"],
  "  "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "An object ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " is called ",
  StyleBox["amenable",
    FontSlant->"Italic"],
  " when ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_1\) : B\_1 \[Rule] B\_0\)]],
  " is powerful in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  "."
}], "Text"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " is a discrete fibration and ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is amenable then ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " is amenable."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-511134216"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_1\) : E\_1 \[Rule] E\_0\)]],
  " is a pullback of ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_1\) : B\_1 \[Rule] B\_0\)]],
  " along ",
  Cell[BoxData[
      \(TraditionalForm\`p\_0\)]],
  ". So the result follows from Corollary ",
  ButtonBox[
  CounterBox["Section", "XRef-Corollary-429151819"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Corollary-429151819"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
