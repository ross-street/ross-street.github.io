Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Theorem ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "TheoremLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is a finitely complete and finitely cocomplete category. For each \
amenable object ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK] = Cat(\[ScriptCapitalE])\)]],
  ":  "
}], "Theorem",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Theorem-510174817"],

Cell[TextData[{
  "each morphism ",
  Cell[BoxData[
      \(TraditionalForm\`f : A \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " factors as ",
  Cell[BoxData[
      \(TraditionalForm\`f = p\ j\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " is a discrete fibration and ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " is final;"
}], "EnunciationItem1Numbered"],

Cell[TextData[{
  "for all discrete fibrations ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] C\)]],
  " and final ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  ", the following square of functors is a pullback."
}], "EnunciationItem1Numbered"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(\[ScriptCapitalK](B, 
              E)\), \(\[LongRightArrow]\&\(\[ScriptCapitalK](1, 
                  p)\)\), \(\[ScriptCapitalK](B, C)\)},
          {\(\(\[InvisiblePrefixScriptBase]\^\(\[ScriptCapitalK](j, 
                    1)\)\)\[DownArrow]\), 
            "=", \(\[DownArrow]\^\(\[ScriptCapitalK](j, 1)\)\)},
          {\(\[ScriptCapitalK](A, 
              E)\), \(\[LongRightArrow]\+\(\[ScriptCapitalK](1, 
                  p)\)\), \(\[ScriptCapitalK](A, C)\)}
          }], TraditionalForm]], "EquationNumbered",
  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    False}}}]
}, Open  ]],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " (1) In ",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-59121246"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-59121246"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-59121246"], "Nil"],
  StyleBox[" we already have ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`f = p\ n\ i\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " is a discrete fibration. Also, ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\ \)\(i\)\)\)]],
  " has a left adjoint and ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  " is a coidentifier. By Propositions ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-59121453"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-59121453"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-59121453"], "Nil"],
  "\[InvisibleSpace], ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-5912153"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-5912153"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-5912153"], "Nil"],
  "\[InvisibleSpace] and ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-5912158"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-5912158"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-5912158"], "Nil"],
  StyleBox[", it follows that ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`j = n\ i\)]],
  " is final.\[InvisibleSpace]\[InvisibleSpace]"
}], "TextContinuation"],

Cell[TextData[{
  "(2) Since ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " admits ",
  Cell[BoxData[
      FormBox[
        SuperscriptBox[\((-)\), 
          StyleBox["2",
            FontWeight->"Bold"]], TraditionalForm]]],
  ", the pullback condition only needs to be verified on objects. By \
Propositions ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-59121453"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-59121453"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-59121453"], "Nil"],
  "\[InvisibleSpace] and ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-59121852"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-59121852"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-59121852"], "Nil"],
  StyleBox[", the reflection of a final ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " into the discrete fibrations over ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is invertible. So ",
  Cell[BoxData[
      \(TraditionalForm\`j : j \[Rule] 1\_B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\_\(\(/\)\(B\)\)\)]],
  " has the property of the unit at ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " for the reflection. This means that, for all ",
  Cell[BoxData[
      \(TraditionalForm\`u : j \[Rule] p\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " a discrete fibration into ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  ", there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`w : 1\_B \[Rule] p\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`w\ j = u\)]],
  ".\[InvisibleSpace]"
}], "Text"],

Cell[BoxData[
    FormBox[GridBox[{
          {"A", \(\[LongRightArrow]\&j\), "B"},
          {\(\(\[InvisiblePrefixScriptBase]\^u\)\[DownArrow]\), \( \
\[LowerLeftArrow] \_w\), \(\[DownArrow]\^1\)},
          {"E", \(\[LongRightArrow]\+p\), "B"}
          }], TraditionalForm]], "EquationNumbered",
  CellTags->"XRef-Equation-59123258"],

Cell[TextData[{
  "We must show more generally that, for all final ",
  Cell[BoxData[
      \(TraditionalForm\`j : A \[Rule] B\)]],
  " and discrete fibrations ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] C\)]],
  ", if ",
  Cell[BoxData[
      \(TraditionalForm\`p\ u = v\ j\)]],
  " then there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`w\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`p\ w = v\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`w\ j = u\)]],
  ". Form the pullback ",
  Cell[BoxData[
      \(TraditionalForm\`P\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`v\)]],
  ". Let ",
  Cell[BoxData[
      \(TraditionalForm\`\(u\^\[Prime]\) : A \[Rule] P\)]],
  " have projections ",
  Cell[BoxData[
      \(TraditionalForm\`u\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`j\)]],
  " from the pullback. Note that ",
  Cell[BoxData[
      \(TraditionalForm\`j = \(p\^\[Prime]\) u\^\[Prime]\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`p\^\[Prime] = pr\_2\)]],
  " is a discrete fibration using Corollary ",
  ButtonBox[
  CounterBox["Section", "XRef-Corollary-429151819"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Corollary-429151819"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Corollary-429151819"], "Nil"],
  "\[InvisibleSpace](3). By ",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-59123258"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-59123258"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-59123258"], "Nil"],
  "\[InvisibleSpace], there exists a unique ",
  Cell[BoxData[
      \(TraditionalForm\`\(w\^\[Prime]\) : B \[Rule] P\)]],
  " such that ",
  Cell[BoxData[
      \(TraditionalForm\`\(p\^\[Prime]\) w\^\[Prime] = 1\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\(w\^\[Prime]\) j = u\^\[Prime]\)]],
  ". So there exists  ",
  Cell[BoxData[
      \(TraditionalForm\`w = \(pr\_1\) w\^\[Prime]\)]],
  " satisfying ",
  Cell[BoxData[
      \(TraditionalForm\`p\ w = v\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`w\ j = u\)]],
  ". Finally, uniqueness is a consequence of the uniqueness of ",
  Cell[BoxData[
      \(TraditionalForm\`w\^\[Prime]\)]],
  " since any such ",
  Cell[BoxData[
      \(TraditionalForm\`w\)]],
  " would induce a ",
  Cell[BoxData[
      \(TraditionalForm\`w\^\[Prime]\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`\(p\^\[Prime]\) w\^\[Prime] = 1\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`w = \(pr\_1\) w\^\[Prime]\)]],
  ", which imply the condition ",
  Cell[BoxData[
      \(TraditionalForm\`\(w\^\[Prime]\) j = u\^\[Prime]\)]],
  ".      ",
  StyleBox["\[EmptySquare]", "QED"],
  " "
}], "TextContinuation"],

