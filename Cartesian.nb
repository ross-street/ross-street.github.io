  " where ",
  Cell[BoxData[
      \(TraditionalForm\`P\&^\)]],
  " is restriction along ",
  Cell[BoxData[
      \(TraditionalForm\`P\^op\)]],
  ". For a powerful ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ", apply this to the case ",
  Cell[BoxData[
      FormBox[
        RowBox[{"P", "=", 
          
          RowBox[{\(\(p\^\[Star]\) : \[ScriptCapitalE]\_\(\(/\)\(B\)\)\), 
            "\[Rule]", 
            RowBox[{\(\[ScriptCapitalE]\_\(\(/\)\(E\)\)\), Cell[""]}]}]}], 
        TraditionalForm]]],
  " and ",
  Cell[BoxData[
      FormBox[
        RowBox[{"Q", "=", 
          SubscriptBox[
            StyleBox["\[CapitalPi]",
              FontSlant->"Plain"], "p"]}], TraditionalForm]]],
  ", noting that the functor   "
}], "TextContinuation"],

