Cell[CellGroupData[{

Cell["\<\
Classification of objects locally isomorphic to some member of a \
given internal family\
\>", "Section"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " denote a finitely complete and let ",
  Cell[BoxData[
      FormBox[
        RowBox[{"\[ScriptCapitalF]", "=", 
          RowBox[{"Hom", "(", 
            RowBox[{\(\[ScriptCapitalE]\^op\), ",", 
              StyleBox["Cat",
                FontWeight->"Bold"]}], ")"}]}], TraditionalForm]]],
  " denote the 2-category of homomorphisms of bicategories (pseudofunctors) \
from ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^op\)]],
  " to ",
  Cell[BoxData[
      FormBox[
        StyleBox["Cat",
          FontWeight->"Bold"], TraditionalForm]]],
  ", strong transformations, and modifications. Recall from ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[16]",
    ButtonData:>"St80",
    ButtonStyle->"Citation",
    ButtonNote->"St80"],
  " that ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  " is a cartesian closed bicategory in the sense that it has an internal hom \
",
  Cell[BoxData[
      \(TraditionalForm\`Y\^X\)]],
  " which appears in an equivalence of categories "
}], "Text",
  CellTags->":bib:St80"],

Cell[BoxData[
    \(TraditionalForm\`\[ScriptCapitalF](Z, 
        Y\^X) \[TildeEqual] \(\(\[ScriptCapitalF](X\[Cross]Z, 
          Y)\)\(\ \)\(.\)\)\)], "Equation"],

Cell[TextData[{
  "Each category ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " will be identified with ",
  Cell[BoxData[
      FormBox[
        RowBox[{\(\[ScriptCapitalE](\(-\(\(,\)\(B\)\)\)) : \
\[ScriptCapitalE]\^op\), "\[Rule]", 
          StyleBox["Cat",
            FontWeight->"Bold"]}], TraditionalForm]]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  ". We identify ",
  Cell[BoxData[
      FormBox[
        RowBox[{"\[ScriptCapitalK]", "=", 
          RowBox[{
            StyleBox["Cat",
              FontWeight->"Plain"], 
            StyleBox["(",
              FontWeight->"Plain"], "\[ScriptCapitalE]", ")"}]}], 
        TraditionalForm]]],
  " with its image in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  " under this embedding ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK] \[Rule] \[ScriptCapitalF]\)]],
  ". Objects in this image are, of course, ",
  StyleBox["categories internal to",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". "
}], "TextContinuation"],

Cell[TextData[{
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`K \[Element] \[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`X \[Element] \[ScriptCapitalF]\)]],
  " then there is a canonical equivalence"
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\[ScriptCapitalF](K, X) \[TildeEqual] 
      X\ K, \ \ \ \ \ x \[RightTeeArrow] x(1\_K), \)], "EquationNumbered"],

Cell[TextData[{
  "and we tend to identify objects and morphisms in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF](K, X)\)]],
  " with their images in ",
  Cell[BoxData[
      \(TraditionalForm\`X\ K\)]],
  ". "
}], "TextContinuation"],

Cell[TextData[{
  "An object ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  " is called a ",
  StyleBox["category with homs internal to",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " when, for all ",
  Cell[BoxData[
      \(TraditionalForm\`K \[Element] \[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`x, \ x\^\[Prime] \[Element] X\ K\)]],
  ", there exists a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`X[x, x\^\[Prime]] \[Rule] K\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " and a bijection "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\[ScriptCapitalE]\_\(\(/\)\(K\)\)\)(L, 
        X[x, x\^\[Prime]]) \[TildeFullEqual] \((X\ L)\) \((\((X\ u)\) 
            x, \((X\ U)\) x\^\[Prime])\)\)], "EquationNumbered"],

Cell[TextData[{
  "which is natural in ",
  Cell[BoxData[
      \(TraditionalForm\`u : L \[Rule] K\)]],
  "."
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Categories internal to ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " have homs internal to ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  "."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem"],

Cell[TextData[{
  StyleBox["Proof. ",
    FontSlant->"Italic"],
  "To obtain ",
  Cell[BoxData[
      \(TraditionalForm\`B[b, b\^\[Prime]]\)]],
  " for a category ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " take the pullback of ",
  Cell[BoxData[
      \(TraditionalForm\`\((d\_0, d\_1)\) : B\_1 \[Rule] 
        B\_0\[Cross]B\_0\)]],
  " along ",
  Cell[BoxData[
      \(TraditionalForm\`\((b, b\^\[Prime])\) : K \[Rule] 
        B\_0\[Cross]B\_0\)]],
  ".      ",
  StyleBox["\[EmptySquare]", "QED"],
  " "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "An object ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  " is said to be ",
  StyleBox["cocomplete at ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`1\)]],
  " when the following conditions hold: "
}], "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  "coequalizers exist in ",
  Cell[BoxData[
      \(TraditionalForm\`X\ 1\)]],
  ";"
}], "Item1Numbered",
  CounterAssignments->{{"Item1Numbered", 0}}],

Cell[TextData[{
  "for each ",
  Cell[BoxData[
      \(TraditionalForm\`\(! \_K\(\(:\)\(K\)\)\) \[Rule] 1\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ", the functor ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(X!\)\_K\) : X\ 1 \[Rule] X\ K\)]],
  " preserves coequalizers; "
}], "Item1Numbered"],

Cell[TextData[{
  "for objects ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`L\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ", the functor ",
  Cell[BoxData[
      \(TraditionalForm\`X\ \(\(pr\_1\) : X\ K\) \[Rule] X(\ K\[Cross]L)\)]],
  " has a left adjoint ",
  Cell[BoxData[
      \(TraditionalForm\`\(X\&^\) pr\_1\)]],
  " and the canonical natural transformation  ",
  Cell[BoxData[
      \(TraditionalForm\`\((\(X\&^\) 
              pr\_1)\) \((X\ pr\_2)\) \[Rule] \((\(X!\)\_K)\) \
\((\(X\&^!\)\_L)\)\)]],
  " is invertible."
}], "Item1Numbered"]
}, Open  ]],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Theorem ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "TheoremLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`C\)]],
  " is a category internal to ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`X \[Element] \[ScriptCapitalF]\)]],
  " is cocomplete at ",
  Cell[BoxData[
      \(TraditionalForm\`1\)]],
  " then each morphism ",
  Cell[BoxData[
      \(TraditionalForm\`g : C \[Rule] X\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  " has a left extension ",
  Cell[BoxData[
      \(TraditionalForm\`col\ \(g : 1\) \[Rule] X\)]],
  " along ",
  Cell[BoxData[
      \(TraditionalForm\`\(! \_C\(\(:\)\(C\)\)\) \[Rule] 1\)]],
  " such that, for all ",
  Cell[BoxData[
      \(TraditionalForm\`K \[Element] \[ScriptCapitalE]\)]],
  ", the following diagram exhibits ",
  Cell[BoxData[
      \(TraditionalForm\`\(\((col\ g)\)!\)\_K\)]],
  " as a left extension of ",
  Cell[BoxData[
      \(TraditionalForm\`g\ pr\_1\)]],
  " along ",
  Cell[BoxData[
      \(TraditionalForm\`pr\_2\)]],
  ". "
}], "Theorem",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(C\[Cross]X\), \(\[LongRightArrow]\&\(pr\_2\)\), "K"},
          {\(\(\[InvisiblePrefixScriptBase]\^pr\_1\)\[DownArrow]\), 
            "=", \(\[DownArrow]\^! \_K\)},
          {"C", "\[LongRightArrow]", "1"},
          {\(\(\(\(\[InvisiblePrefixScriptBase]\)\(\ \ \)\)\^g\)\(\
\[LowerRightArrow]\)\), 
            "\[DoubleLongRightArrow]", \( \[LowerLeftArrow] \^\(col\ g\)\)},
          {".", "X", "."}
          }], TraditionalForm]], "Equation",
  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    False}}}]
}, Open  ]],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " We seek, in the first instance, a left adjoint to the functor ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF](1, X) \[Rule] \[ScriptCapitalF](C, 
          X)\)]],
  ". Recall the extension of Yoneda\[CloseCurlyQuote]s Lemma given in Section \
5 of ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  ": namely, there is a canonical equivalence  "
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\[ScriptCapitalF](C, 
        X) \[TildeEqual] \(\[ScriptCapitalG](X)\) C\)], "Equation"],

Cell[TextData[{
  "where ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalG](X) \[Rule] \[ScriptCapitalE]\)]],
  " is the fibration arising on application of the Grothendieck construction \
to ",
  Cell[BoxData[
      FormBox[
        RowBox[{\(X : \[ScriptCapitalE]\^op\), "\[Rule]", 
          StyleBox["Cat",
            FontWeight->"Bold"]}], TraditionalForm]]],
  ", and ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[ScriptCapitalG](X)\) C\)]],
  " denotes the category of categories ",
  Cell[BoxData[
      \(TraditionalForm\`T\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalG](X)\)]],
  " which lie over ",
  Cell[BoxData[
      \(TraditionalForm\`C\)]],
  " and have ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_0\) : T\_1 \[Rule] T\_0\)]],
  " cartesian (the word \[OpenCurlyDoubleQuote]full\[CloseCurlyDoubleQuote] \
on the second line of (5.13) in ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  " should obviously be deleted!). We seek a left adjoint to the functor    "
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\[CapitalDelta] : 
      X\ 1\[LongRightArrow]\(\[ScriptCapitalG](X)\) C\)], "Equation"],

Cell[TextData[{
  "which takes ",
  Cell[BoxData[
      \(TraditionalForm\`z\)]],
  " to the category in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalG](X)\)]],
  " with object of objects ",
  Cell[BoxData[
      \(TraditionalForm\`\((B\_0, \((\(X!\)\_\(B\_0\))\) z)\)\)]],
  " and each ",
  Cell[BoxData[
      \(TraditionalForm\`d\_i\)]],
  " cartesian. (When ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " has small coproducts, ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[ScriptCapitalG](X)\) C\)]],
  " is monadic over ",
  Cell[BoxData[
      \(TraditionalForm\`X\ C\_0\)]],
  " and an adjoint triangle gives the result (compare (9.10) and (9.15) of ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  ").  "
}], "TextContinuation"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Theta]\_i\) : \((\(X\&^!\)\_\(B\_1\))\) \((X\ \
d\_\(\(i\)\(\ \)\))\) \[Rule] \(X\&^!\)\_\(B\_0\)\)]],
  " be the 2-cell corresponding under adjunction to ",
  Cell[BoxData[
      \(TraditionalForm\`\((X\ d\_\(\(i\)\(\ \)\))\) \((\(X!\)\_B)\) \
\[TildeFullEqual] \(X!\)\_\(B\_1\)\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_\(\(i\)\(\ \)\)\) : \ 
          B\_\(\(1\)\(\ \)\) \[Rule] B\_\(\(0\)\(\ \)\)\)]],
  ". Take ",
  Cell[BoxData[
      \(TraditionalForm\`T\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[ScriptCapitalG](X)\) C\)]],
  ". The morphism ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_\(\(1\)\(\ \)\)\) : \ 
          T\_\(\(1\)\(\ \)\) \[Rule] T\_\(\(0\)\(\ \)\)\)]],
  " consists of ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_\(\(1\)\(\ \)\)\) : \ 
          B\_\(\(1\)\(\ \)\) \[Rule] B\_\(\(0\)\(\ \)\)\)]],
  " and a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`\[Xi] : \((X\ d\_0)\) t \[Rule] \((X\ d\_1)\) t\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`X\ B\_1\)]],
  ", where ",
  Cell[BoxData[
      \(TraditionalForm\`T\_n = \((B\_n, t\_n)\)\)]],
  ".   "
}], "Text"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`c \[Element] X\ 1\)]],
  " be the coequalizer of the two morphisms"
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\((\(X\&^!\)\_\(B\_1\))\) \((X\ d\_\(\(0\)\(\ \)\))\) 
      t\_0\(\[LongRightArrow]\&\(\(\[Theta]\_0\) 
              t\_0\)\)\((\(X\&^!\)\_\(B\_0\))\) 
      t\_0\ \ \ \ \ and\ \ \ \ \ \((\(X\&^!\)\_\(B\_1\))\) \((X\ d\_\(\(0\)\(\
\ \)\))\) 
      t\_0\(\[LongRightArrow]\&\(\((\(X\&^!\)\_\(B\_1\))\) \
\[Xi]\)\)\((\(X\&^!\)\_\(B\_1\))\) \((X\ d\_\(\(1\)\(\ \)\))\) 
      t\_0\(\[LongRightArrow]\&\(\(\[Theta]\_1\) 
              t\_0\)\)\((\(X\&^!\)\_\(B\_0\))\) \(\(t\_0\)\(\ \ \)\(.\)\)\)], \
"Equation"],

Cell[TextData[{
  "A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`c \[Rule] z\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`X\ 1\)]],
  " then amounts to a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`\((B\_0, 
          t\_0)\) \[Rule] \((B\_0, \((\(X!\)\_\(B\_0\))\) z)\)\)]],
  ", which has a unique extension to a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`T \[Rule] \[CapitalDelta](z)\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[ScriptCapitalG](X)\) C\)]],
  ". "
}], "TextContinuation"],

Cell[TextData[{
  "So take ",
  Cell[BoxData[
      \(TraditionalForm\`col\ g = c\)]],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`g\)]],
  " corresponds to ",
  Cell[BoxData[
      \(TraditionalForm\`T\)]],
  ". Conditions (2) and (3) of \[OpenCurlyDoubleQuote]cocomplete at 1\
\[CloseCurlyDoubleQuote] yield the property of ",
  Cell[BoxData[
      \(TraditionalForm\`\(\((col\ g)\)!\)\_K\)]],
  " in a straightforward manner",
  ".      ",
  StyleBox["\[EmptySquare]", "QED"]
}], "Text"],

Cell["", "Text"],

Cell[TextData[{
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`f : B \[Rule] X\)]],
  " is a morphism in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalF]\)]],
  ". An object ",
  Cell[BoxData[
      \(TraditionalForm\`z \[Element] X\ 1\)]],
  " is ",
  StyleBox["locally isomorphic to a value of",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`f\)]],
  " when there exist a regular epimorphism ",
  Cell[BoxData[
      \(TraditionalForm\`R \[Rule] 1\)]],
  ", an object ",
  Cell[BoxData[
      \(TraditionalForm\`b \[Element] B\ R\)]],
  ", and an isomorphism "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(f\_R\)(b) \[TildeFullEqual] \((\(X!\))\) 
        z\)], "EquationNumbered"],

Cell[TextData[{
  "in ",
  Cell[BoxData[
      \(TraditionalForm\`X\ R\)]],
  "."
}], "TextContinuation"]
}, Open  ]],

