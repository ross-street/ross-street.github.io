  CellTags->"XRef-Proposition-5918542"],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " is a discrete fibration and ",
  Cell[BoxData[
      \(TraditionalForm\`b : X \[Rule] B\)]],
  " has discrete domain ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  " then the composite"
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-5516046"],

Cell[BoxData[
    \(TraditionalForm\`E\ b = 
      E\(\[Cross]\+B\)X\[LongRightArrow]\ \((b/
              p)\)\[LongRightArrow]\(\(\[Pi]\_0\)(
            b/p)\)\)], "EquationNumbered",
  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
