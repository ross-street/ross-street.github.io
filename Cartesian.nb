  "\[InvisibleSpace], Theorem ",
  ButtonBox[
  CounterBox["Section", "XRef-Theorem-510174817"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Theorem-510174817"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Theorem-510174817"], "Nil"],
  "\[InvisibleSpace](b) gives a unique ",
