              URL[ "mailto:street@math.mq.edu.au"], None},
            ButtonStyle->"AuthorEmail"]], TraditionalForm]], "AuthorData"]
}], "Author",
  TaggingRules:>{"AuthorData" -> {"TeX" -> {
    "\\author{Ross Street}\n\\address{Macquarie University, NSW 2109, \
Australia}\n\\email{street@math.mq.edu.au}\n\
\\urladdr{www.math.mq.edu.au/{\\textasciitilde}street/}"}, "XML" -> {}}, 
    "RadioButtonData" -> {"Settings" -> {}, "TeX" -> {}, 
    "XML" -> {}}}]], "Author"],

Cell["October 2011", "Date"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["B O D Y", "MainmatterGroup"],

Cell[CellGroupData[{

Cell["Abstract", "AbstractSection"],

Cell["\<\
This note was inspired by some considerations on the so-called \
\[OpenCurlyDoubleQuote]pushout product of morphisms\[CloseCurlyDoubleQuote] \
used in Quillen homotopy model categories. The results are expressed in terms \
of cartesian morphisms for a given functor.    \
\>", "Abstract"]
}, Open  ]]
}, Open  ]],

Cell[CellGroupData[{

Cell["B O D Y", "MainmatterGroup"],

Cell[CellGroupData[{

Cell["Review of cartesian morphisms", "Section"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`P : \[ScriptCapitalA]\[LongRightArrow]\
\[ScriptCapitalX]\)]],
  " be a functor. A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`f : A\[LongRightArrow]B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalA]\)]],
  " is called ",
  StyleBox["cartesian",
    FontSlant->"Italic"],
  " when the square"
}], "Text"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(\[ScriptCapitalA](K, 
              A)\), \(\[LongRightArrow]\&\(\[ScriptCapitalA](1, 
                  f)\)\), \(\[ScriptCapitalA](K, B)\)},
          {\(\(\[InvisiblePrefixScriptBase]\^P\)\[DownArrow]\), 
            "\[Placeholder]", \(\[DownArrow]\^P\)},
          {\(\[ScriptCapitalX](P\ K, 
              P\ A)\), \(\[LongRightArrow]\+\(\[ScriptCapitalX](1, P\ f)\)\), 
            
            StyleBox[\(\[ScriptCapitalX](P\ K, P\ B)\),
              FontWeight->"Plain"]}
          }], TraditionalForm]], "EquationNumbered"],

Cell[TextData[{
  "is a pullback for all objects ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalA]\)]],
  "."
}], "TextNoIndent"],

Cell[TextData[{
  "With suitable choice of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " the above cohomology amounts to the usual cohomology of a space with \
coefficients in a sheaf ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " of abelian groups over the space, the usual cohomology of a group with \
coefficients in a module ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " over the integral group-ring of the group, etale cohomology, and so on."
}], "Text"],

Cell[TextData[{
  "Giraud",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[2]",
    ButtonData:>"Giraud",
    ButtonStyle->"Citation",
    ButtonNote->"Giraud"],
  " generalized the constructions ",
  Cell[BoxData[
      \(TraditionalForm\`\(H\^n\)(\[ScriptCapitalE]; B)\)]],
  " for ",
  Cell[BoxData[
      \(TraditionalForm\`n = 0, \ 1, \ 2\)]],
  " to accommodate a group ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " which is not necessarily abelian. There is no difficulty with ",
  Cell[BoxData[
      \(TraditionalForm\`n = 0\)]],
  " where we take the group ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE](1, B)\)]],
  ". For ",
  Cell[BoxData[
      \(TraditionalForm\`n = 1\)]],
  ", the notion of ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor is required: this is an object ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " on which ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " acts such that ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " is locally isomorphic to ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " acting on itself (\[OpenCurlyDoubleQuote]locally\[CloseCurlyDoubleQuote] \
here means \[OpenCurlyDoubleQuote]on passing to a cover\
\[CloseCurlyDoubleQuote]). Then ",
  Cell[BoxData[
      \(TraditionalForm\`\(H\^1\)(\[ScriptCapitalE]; B)\)]],
  " is the pointed set of isomorphism classes of ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors. A basic result of Giraud is that, given an object ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " enriched with some structure, if ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " denotes the group of structure automorphisms of ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  ", then ",
  Cell[BoxData[
      \(TraditionalForm\`\(H\^1\)(\[ScriptCapitalE]; B)\)]],
  " classifies the objects fo ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " locally structure isomorphic to ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  ".   "
}], "Text",
  CellTags->":bib:Giraud"],

Cell[TextData[{
  "The definitions of Giraud can be generalized to an elementary topos ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " (",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[3]",
    ButtonData:>"JohnstnTT",
    ButtonStyle->"Citation",
    ButtonNote->"JohnstnTT"],
  " and ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[4]",
    ButtonData:>"Dusk82",
    ButtonStyle->"Citation",
    ButtonNote->"Dusk82"],
  ")."
}], "Text",
  CellTags->{":bib:Dusk82", ":bib:JohnstnTT"}],

Cell[TextData[{
  "The purpose of the present paper is to present a generalization for ",
  Cell[BoxData[
      \(TraditionalForm\`n = 1\)]],
  " to the case where ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is a finitely complete, finitely cocomplete, cartesian closed category \
and ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is a category in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". There have been two basic sources of inspiration for this work. One is \
the observation of Roberts",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[5]",
    ButtonData:>"Rob77",
    ButtonStyle->"Citation",
    ButtonNote->"Rob77"],
  " that what one needs in order to be able to express the ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-cocycle condition is an ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-category (any set is a 0-category, a group gives a 1-category with one \
object, an abelian group gives an ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-category with one ",
  Cell[BoxData[
      \(TraditionalForm\`\((n - 1)\)\)]],
  "-cell for all ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "). This suggests that there should be an ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-category of ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-cocycles with coefficients in an ",
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-category; 0-cohomology would then be the set of 0-cocycles, 1-cohomology \
would be the set of isomorphism classes of 1-cocycles, 2-cohomology would be \
the set of equivalence classes of 2-cocycles, and so on."
}], "Text",
  CellTags->":bib:Rob77"],

Cell[TextData[{
  "Andr\[EAcute] Joyal\[CloseCurlyQuote]s lectures in the Category Seminar at \
Macquarie University (22 October and 5 November 1980) were the other source \
of inspiration. Andr\[EAcute] stressed the important case where ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is a groupoid in a fairly general category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " (a groupoid is a category in which every morphism is invertible; a group \
is a groupoid with one object). He defined a ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor to be a discrete fibration ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " over ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " which is locally representable and said that the relationship between ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors and cocycles could be explained in terms of the comprehensive \
factorization of a functor into a final functor followed by a discrete \
fibration ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[6]",
    ButtonData:>"SW73",
    ButtonStyle->"Citation",
    ButtonNote->"SW73"],
  ". "
}], "Text",
  CellTags->":bib:SW73"],

Cell[TextData[{
  "In a topos it is rewarding to view a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`u : L \[Rule] K\)]],
  " as an internal expression of a family of objects parametrized by ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  ". In a merely finitely complete category in general this point of view \
makes little sense, so in Section ",
  ButtonBox[
  CounterBox["Section", "XRef-Section-53212849"],
    ButtonData:>{"Counter" -> "Section", "CounterTag" -> 
      "XRef-Section-53212849"},
    ButtonStyle->"XRef",
    ButtonNote->"Link to Section"],
  "\[InvisibleSpace] we have suggested the notion of powerful morphisms \
should play this role. Every morphism in a topos is powerful. The powerful \
morphisms in the category of categories are known (originally due to ",
  ButtonBox["[11] ",
    ButtonData:>{"H^1.nb", ":bib:Giraud64"},
    ButtonStyle->"RefReturnLink"],
  "and ",
  ButtonBox["[12]",
    ButtonData:>{"H^1.nb", ":bib:Cond"},
    ButtonStyle->"RefReturnLink"],
  "; also see Theorem 2.37 of ",
  ButtonBox["[3]",
    ButtonData:>{"H^1.nb", ":bib:JohnstnTT"},
    ButtonStyle->"RefReturnLink"],
  ") and include both fibrations and opfibrations. Via the inverse of the \
Grothendieck construction (see Section 1 of ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  " for example) a fibration certainly represents a family of categories \
parametrized by a category. "
}], "Text"],

Cell[TextData[{
  "In an arbitrary finitely complete and finitely cocomplete category we \
provide, in Section 2, an efficient proof that each functor into an ",
  StyleBox["amenable category",
    FontSlant->"Italic"],
  " factors comprehensively and that this factorization is functorial. A \
category ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is amenable when the codomain morphism ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_1\) : B\_1 \[Rule] B\_0\)]],
  " is powerful."
}], "Text"],

Cell[TextData[{
  "Section 3 brings us to the notion of a ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  StyleBox["-torsor",
    FontSlant->"Italic"],
  " where ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is a category in a finitely complete category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". In topos theory it has been suggested that (in view of Section 8.3 of \
Johnstone ",
  ButtonBox["[3]",
    ButtonData:>{"H^1.nb", ":bib:JohnstnTT"},
    ButtonStyle->"RefReturnLink"],
  ") a ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor in a topos ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " should perhaps be a ",
  StyleBox["flat",
    FontSlant->"Italic"],
  " discrete fibration ",
  Cell[BoxData[
      \(TraditionalForm\`\(\(\ \)\(E\)\)\)]],
  " over ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " although we know of no results concerning such torsors with ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " not a groupoid except that the topos ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^B\)]],
  " would then be the ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor classifier. Instead, the definition taken here is that a ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor is a discrete fibration over ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " which is locally representable (that is, on passing to a cover, looks \
like ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_0\) : \((B/x)\) \[Rule] B\)]],
  "). This leads to a category ",
  Cell[BoxData[
      \(TraditionalForm\`Tors(B)\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors. We contend that one-dimensional cohomology is the study of the \
categories ",
  Cell[BoxData[
      \(TraditionalForm\`Tors(B)\)]],
  "."
}], "Text"],

Cell[TextData[{
  "It will be clear (after Theorem ??) that a ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsor amounts precisely to a ",
  Cell[BoxData[
      \(TraditionalForm\`B\_g\)]],
  "-torsor where ",
  Cell[BoxData[
      \(TraditionalForm\`B\_g\)]],
  " is the groupoid obtained from ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " by restricting to invertible morphisms in ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  ". So one may ask: is it not sufficient to consider ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors where ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is a groupoid? No! For what we in fact have is an equivalence of \
categories  "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\(\(Tors(B)\)\_g \[TildeEqual] 
      Tors(B\_g)\)\(,\)\)\)], "EquationNumbered"],

Cell[TextData[{
  "and it is not possible to glean all the important information about a \
category ",
  Cell[BoxData[
      \(TraditionalForm\`Tors(B)\)]],
  " from the associated groupoid. For example, in Section ",
  ButtonBox[
  CounterBox["Section", "XRef-Section-5421176"],
    ButtonData:>{"Counter" -> "Section", "CounterTag" -> 
      "XRef-Section-5421176"},
    ButtonStyle->"XRef",
    ButtonNote->"Link to Section"],
  ButtonBox[" ",
    ButtonData:>{"Counter" -> "Section", "CounterTag" -> 
      "XRef-Section-5421176"},
    ButtonStyle->"XRef",
    ButtonNote->"Link to Section"],
  "\[InvisibleSpace]we give a technique for deriving results about finiteness \
in a topos, vector bundles, and other local structures, which could not be \
obtained by restricting to groupoids."
}], "TextContinuation"],

Cell[TextData[{
  "Here, a ",
  StyleBox["cover",
    FontSlant->"Italic"],
  " is taken to mean an object ",
  Cell[BoxData[
      \(TraditionalForm\`R\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " for which ",
  Cell[BoxData[
      \(TraditionalForm\`R \[Rule] 1\)]],
  " is a regular epimorphism (that is, a coequalizer of some pair of \
morphisms). When ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is cartesian closed, covers are closed under finite products. All our \
results apply equally well when covers are replaced by any subclass closed \
under finite products."
}], "Text"],

Cell[TextData[{
  "Apart from some basics about powerful morphisms and an internalization of \
the comprehensive factorization ",
  ButtonBox["[6]",
    ButtonData:>{"H^1.nb", ":bib:SW73"},
    ButtonStyle->"RefReturnLink"],
  " the two main results of this paper are the Clutching Theorem ?? and the \
Classification Theorem ??. The first of these establishes the relationship \
between ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors and \[CapitalCHacek]ech ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-cocycles when ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is an amenable category in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ". The second, which warrants some explanation here, generalizes the result \
of Giraud mentioned near the beginning of this Introduction."
}], "Text"],

Cell[TextData[{
  "When viewing a category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " as a universe of discourse and categories in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " as \[OpenCurlyDoubleQuote]small categories\[CloseCurlyDoubleQuote], a \
useful concept of \[OpenCurlyDoubleQuote]large category\
\[CloseCurlyDoubleQuote] is that of homomorphism ",
  Cell[BoxData[
      FormBox[
        RowBox[{\(X : \[ScriptCapitalE]\^op\), "\[Rule]", 
          StyleBox["Cat",
            FontWeight->"Bold"]}], TraditionalForm]]],
  " (or \[OpenCurlyDoubleQuote]pseudofunctor\[CloseCurlyDoubleQuote], or, \
equivalently, fibration over ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  "); for ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ", we think of the objects of ",
  Cell[BoxData[
      \(TraditionalForm\`X\ K\)]],
  " as \[OpenCurlyDoubleQuote]",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  "-indexed families of objects of the large category ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  "\[CloseCurlyDoubleQuote]. In accordance with our view of powerful \
morphisms, ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " becomes the underlying external category for the large category ",
  Cell[BoxData[
      \(TraditionalForm\`P\)]],
  " with ",
  Cell[BoxData[
      \(TraditionalForm\`P\ K\)]],
  " taken to be the category of powerful morphisms into ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  ". Categories constructed as consisting of structures in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " (for example, the category of rings in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  ") also underlie large categories (this means more than the observation \
that the category of rings in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " has homs enriched in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  "). The Classification Theorem concerns suitably cocomplete large \
categories ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  "-indexed families ",
  Cell[BoxData[
      \(TraditionalForm\`x\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  "-objects; it states that ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  StyleBox["-objects locally isomorphic to some member of the family ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`x\)]],
  " ",
  StyleBox["are classified by ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`X[x]\)]],
  StyleBox["-torsors, where ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`X[x]\)]],
  StyleBox[" is the small category in ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " \[OpenCurlyDoubleQuote]",
  StyleBox["of members of the family ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`x\)]],
  " ",
  StyleBox["and all ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  StyleBox["-arrows between them\[CloseCurlyDoubleQuote]. ",
    FontSlant->"Italic"],
  "   "
}], "Text"],

Cell[TextData[{
  "Finally, note that, if ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalC]\)]],
  " is a finitely complete, finitely cocomplete, cartesian closed category \
then so too is the category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " underlying the 2-category ",
  Cell[BoxData[
      \(TraditionalForm\`Cat(\[ScriptCapitalC])\)]],
  " of categories in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalC]\)]],
  ". Thus by recursion, we can apply our results to multiple categories ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  " in a topos: it can be seen (using Theorem ",
  ButtonBox[
  CounterBox["Section", "XRef-Theorem-55152725"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Theorem-55152725"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Theorem-55152725"], "Nil"],
  StyleBox[") that multiple categories arising from ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`n\)]],
  "-categories are amenable. For example, an abelian group ",
  Cell[BoxData[
      \(TraditionalForm\`G\)]],
  " in a topos ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalC]\)]],
  " gives rise to a group ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " (as above); with the notion of cover in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " taken to be that of connected groupoid, ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  "-torsors in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " are closely related to elements of ",
  Cell[BoxData[
      \(TraditionalForm\`\(H\^2\)(\[ScriptCapitalC]; G)\)]],
  ". This process of obtaining higher cohomologies as one-dimensional \
cohomologies under the recursion will be pursued elsewhere. \[InvisibleSpace] \
 "
}], "Text"]
}, Open  ]],

Cell[CellGroupData[{

Cell["Powerful morphisms", "Section",
  CellTags->"XRef-Section-53212849"],

Cell[TextData[{
  "Considerable use will be made of the Adjoint Triangle Theorem of Dubuc ",
  ButtonBox["[8]",
    ButtonData:>{"H^1.nb", ":bib:Dubuc"},
    ButtonStyle->"RefReturnLink"],
  " in the following form."
}], "Text"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Lemma ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "LemmaLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose the functor ",
  Cell[BoxData[
      \(TraditionalForm\`F : \[ScriptCapitalB] \[Rule] \[ScriptCapitalX]\)]],
  " has a right adjoint ",
  Cell[BoxData[
      \(TraditionalForm\`U\)]],
  " with the all components of the unit ",
  Cell[BoxData[
      \(TraditionalForm\`\[Eta] : 1 \[Rule] U\ F\)]],
  " regular monomorphisms in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB]\)]],
  ". Any functor ",
  Cell[BoxData[
      \(TraditionalForm\`S : \[ScriptCapitalA] \[Rule] \[ScriptCapitalB]\)]],
  " has a right adjoint if and only if the composite ",
  Cell[BoxData[
      \(TraditionalForm\`F\ S\)]],
  " does.  "
}], "Lemma",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Lemma-51616391"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`F\ S\)]],
  " has right adjoint ",
  Cell[BoxData[
      \(TraditionalForm\`Q\)]],
  ". Each morphism ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[Eta]\_B\) : B \[Rule] U\ F\ B\)]],
  " is an equalizer of two morphism into some object ",
  Cell[BoxData[
      \(TraditionalForm\`C\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB]\)]],
  ". But ",
  Cell[BoxData[
      \(TraditionalForm\`\[Eta]\_C\)]],
  " is a monomorphism. So ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is an equalizer of two morphisms ",
  Cell[BoxData[
      \(TraditionalForm\`U\ F\ B \[Rule] U\ F\ C\)]],
  ". So ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB](S\ A, B)\)]],
  " is the equalizer of two morphisms ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB](S\ A, 
          U\ F\ B) \[Rule] \[ScriptCapitalB](S\ A, U\ F\ C)\)]],
  ", naturally in ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  ". Using ",
  Cell[BoxData[
      \(TraditionalForm\`F \[LeftTee] U\)]],
  ", we see that ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB](S\ A, B)\)]],
  " is the equalizer of two morphisms ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalX](F\ S\ A, 
          F\ B) \[Rule] \[ScriptCapitalX](F\ S\ A, F\ C)\)]],
  ", naturally in ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  ". Using ",
  Cell[BoxData[
      \(TraditionalForm\`F\ S \[LeftTee] Q\)]],
  ", we see that ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalB](S\ A, B)\)]],
  " is the equalizer of two morphisms ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalA](A, 
          Q\ F\ B) \[Rule] \[ScriptCapitalA](A, Q\ F\ C)\)]],
  ", naturally in ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  ". By Yoneda\[CloseCurlyQuote]s Lemma, we obtain two morphisms ",
  Cell[BoxData[
      \(TraditionalForm\`Q\ F\ B \[Rule] Q\ F\ C\)]],
  " whose equalizer ",
  Cell[BoxData[
      \(TraditionalForm\`T\ B\)]],
  " has ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalA](A, 
          T\ B) \[TildeFullEqual] \[ScriptCapitalB](S\ A, B)\)]],
  ", naturally in ",
  Cell[BoxData[
      \(TraditionalForm\`A\)]],
  Cell[BoxData[
      FormBox[
        RowBox[{".", "         ", 
          StyleBox["\[EmptySquare]",
            "QED"]}], TraditionalForm]]],
  "      "
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  Cell[TextData[{
    "Remark ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "RemarkLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "The assumptions in the first sentence of the lemma hold when ",
  Cell[BoxData[
      \(TraditionalForm\`F\)]],
  " is comonadic. On the other hand, the assumptions on ",
  Cell[BoxData[
      \(TraditionalForm\`F\)]],
  " generally imply that ",
  Cell[BoxData[
      \(TraditionalForm\`F\)]],
  " is conservative (reflects invertibility). A related observation is that \
restriction along ",
  Cell[BoxData[
      \(TraditionalForm\`U\)]],
  " reflects the invertibility of natural transformations ",
  Cell[BoxData[
      \(TraditionalForm\`\[Alpha] : 
          H \[Implies] \(K : \[ScriptCapitalA]\) \[Rule] \
\[ScriptCapitalB]\)]],
  " between equalizer-preserving functors ",
  Cell[BoxData[
      \(TraditionalForm\`H\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`K\)]],
  "."
}], "Remark",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem"],

Cell["", "Text"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " denote a finitely complete category. A morphism ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is called ",
  StyleBox["powerful",
    FontSlant->"Italic"],
  " when the functor "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\(-\(\(\[Cross]\+B\)\(E : \[ScriptCapitalE]\_\(\(/\)\
\(B\)\)\[LongRightArrow]\[ScriptCapitalE]\)\)\)\(,\)\)\)], "EquationNumbered"],

Cell[TextData[{
  "which assigns to each object of the slice category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)]],
  " its pullback with ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  ", has a right adjoint. (The term \[OpenCurlyDoubleQuote]exponentiable\
\[CloseCurlyDoubleQuote] ",
  "instead of \[OpenCurlyDoubleQuote]powerful\[CloseCurlyDoubleQuote] ",
  "has been used in the literature.) The following result is adapted to this \
terminology from Freyd ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[7]",
    ButtonData:>"Freyd72",
    ButtonStyle->"Citation",
    ButtonNote->"Freyd72"],
  "."
}], "TextContinuation",
  CellTags->":bib:Freyd72"],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "The following conditions on a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " are equivalent:"
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-426214536"],

Cell[TextData[{
  "the morphism ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " is powerful;"
}], "EnunciationItem1Numbered"],

Cell["the functor", "EnunciationItem1Numbered"],

Cell[BoxData[
    \(TraditionalForm\`\(\(\(p\^\[Star]\) : \[ScriptCapitalE]\_\(\(/\)\(B\)\)\
\[LongRightArrow]\[ScriptCapitalE]\_\(\(/\)\(E\)\)\)\(,\)\)\)], \
"EquationNumbered",
  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    False}}}],

Cell[TextData[{
  "defined by pulling back along ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  ", has a right adjoint ",
  Cell[BoxData[
      FormBox[
        SubscriptBox[
          StyleBox["\[CapitalPi]",
            FontSlant->"Plain"], "p"], TraditionalForm]]],
  ";",
  Cell[BoxData[
      FormBox[
        StyleBox[
          SubscriptBox["", Cell[TextData[StyleBox["",
              FontSlant->"Italic"]]]],
          FontSlant->"Plain"], TraditionalForm]]]
}], "EnunciationItem1Paragraph"],

Cell[TextData[{
  "exponentiation exists with respect to the index ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in the category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)]],
  ". "
}], "EnunciationItem1Numbered"]
}, Open  ]],

Cell["", "Text"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " Consider the functor ",
  Cell[BoxData[
      \(TraditionalForm\`\(\[CapitalSigma]\_E\) : \
\[ScriptCapitalE]\_\(\(/\)\(E\)\) \[Rule] \[ScriptCapitalE]\)]],
  " taking each morphism into ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " to its domain. It has a right adjoint ",
  Cell[BoxData[
      \(TraditionalForm\`\[CapitalSigma]\_E \[LeftTee] \
\[CapitalDelta]\_E\)]],
  " taking ",
  Cell[BoxData[
      \(TraditionalForm\`X\)]],
  " to ",
  Cell[BoxData[
      \(TraditionalForm\`X\[Cross]E\)]],
  " over ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " via the second projection. The unit of the adjunction is a componentwise \
regular monomorphism. By Lemma ",
  ButtonBox[
  CounterBox["Section", "XRef-Lemma-51616391"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Lemma-51616391"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Lemma-51616391"], "Nil"],
  "\[InvisibleSpace], the functor ",
  Cell[BoxData[
      \(TraditionalForm\`\(p\^\[Star]\) : \[ScriptCapitalE]\_\(\(/\)\(B\)\)\
\[LongRightArrow]\[ScriptCapitalE]\_\(\(/\)\(E\)\)\)]],
  " has a right adjoint if and only if ",
  Cell[BoxData[
      \(TraditionalForm\`\(-\(\(\[Cross]\+B\)\(E\)\)\) = \(\[CapitalSigma]\_E\
\) \(p\^\[Star]\)\)]],
  " does. This proves the equivalence of ",
  StyleBox["(1) and (2).",
    Editable->True]
}], "TextContinuation"],

Cell[TextData[{
  "Product with the object ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)]],
  " is the composite "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\[ScriptCapitalE]\_\(\(/\)\(B\)\)\(\[LongRightArrow]\
\&\(p\^\[Star]\)\)\[ScriptCapitalE]\_\(\(/\)\(E\)\)\)\(\[LongRightArrow]\&\(\
\[CapitalSigma]\_p\)\)\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)], "Equation"],

Cell[TextData[{
  "where ",
  Cell[BoxData[
      \(TraditionalForm\`\[CapitalSigma]\_p \[LeftTee] \(p\^\[Star]\)\)]],
  ". It follows that (2) implies (3)."
}], "TextContinuation"],

Cell[TextData[{
  "To see that (3) implies (1), notice that the functor ",
  Cell[BoxData[
      \(TraditionalForm\`\(-\(\(\[Cross]\+B\)\(E\)\)\)\)]],
  " is the composite"
}], "Text"],

Cell[BoxData[
    FormBox[
      RowBox[{\(\(\(\[ScriptCapitalE]\_\(\(/\)\(B\)\)\(\[LongRightArrow]\&\(p\
\^\[Star]\)\)\[ScriptCapitalE]\_\(\(/\)\(E\)\)\)\(\[LongRightArrow]\&\(\
\[CapitalSigma]\_p\)\)\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)\(\[LongRightArrow]\&\
\(\[CapitalSigma]\_B\)\)\[ScriptCapitalE]\), ".", "         ", 
        StyleBox["\[EmptySquare]",
          "QED"]}], TraditionalForm]], "Equation"],

Cell["", "Text"],

Cell[TextData[{
  " In a category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalC]\)]],
  " with finite products, an object ",
  Cell[BoxData[
      \(TraditionalForm\`P\)]],
  " is said to be ",
  StyleBox["powerful",
    FontSlant->"Italic"],
  " when the functor ",
  Cell[BoxData[
      \(TraditionalForm\`P\[Cross]- : \[ScriptCapitalC] \[Rule] \
\[ScriptCapitalC]\)]],
  " has a right adjoint. So, by Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-426214536"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-426214536"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-426214536"], "Nil"],
  "\[InvisibleSpace](3), a morphism ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is powerful if and only if it is powerful as an object of the category ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\_\(\(/\)\(B\)\)\)]],
  ". An object ",
  Cell[BoxData[
      \(TraditionalForm\`E\)]],
  " of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is powerful if and only if the morphism ",
  Cell[BoxData[
      \(TraditionalForm\`E \[Rule] 1\)]],
  " is powerful. "
}], "Text"],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Corollary ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "CorollaryLabel",
    TaggingRules:>{"CellLabel" -> True}],
  ""
}], "Corollary",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Corollary-429151819"],

Cell["Isomorphisms are powerful.", "EnunciationItem1Numbered"],

Cell["The composite of powerful morphisms is powerful.", \
"EnunciationItem1Numbered"],

Cell["The pullback of a powerful morphism is powerful.    ", \
"EnunciationItem1Numbered"]
}, Open  ]],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " The only one of these that needs any comment is (3) and this follows from \
Lemma ",
  ButtonBox[
  CounterBox["Section", "XRef-Lemma-51616391"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Lemma-51616391"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Lemma-51616391"], "Nil"],
  "\[InvisibleSpace] since the unit of each adjunction ",
  Cell[BoxData[
      \(TraditionalForm\`\[CapitalSigma]\_f \[LeftTee] \(f\^\[Star]\)\)]],
  " is a regular monomorphism.    ",
  Cell[BoxData[
      FormBox[
        StyleBox[\(\(\[EmptySquare]\)\(\ \)\),
          "QED",
          FontSlant->"Plain"], TraditionalForm]]]
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "Given a functor ",
  Cell[BoxData[
      \(TraditionalForm\`F : \[ScriptCapitalE] \[Rule] \[ScriptCapitalX]\)]],
  ", we write ",
  Cell[BoxData[
      \(TraditionalForm\`\(F\_B\) : \[ScriptCapitalE]\_\(\(/\)\(B\)\) \[Rule] \
\[ScriptCapitalX]\_\(\(\(/\)\(F\)\)\ B\)\)]],
  " for the functor induced by ",
  Cell[BoxData[
      \(TraditionalForm\`F\)]],
  " in the obvious way on slice categories. "
}], "Text"],

Cell[TextData[{
  "For a powerful morphism ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  ", a pullback preserving functor ",
  Cell[BoxData[
      \(TraditionalForm\`F : \[ScriptCapitalE] \[Rule] \[ScriptCapitalX]\)]],
  " is said to ",
  StyleBox["preserve internal ",
    FontSlant->"Italic"],
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  StyleBox["-products ",
    FontSlant->"Italic"],
  "when ",
  Cell[BoxData[
      \(TraditionalForm\`F\ p\)]],
  " is powerful and the canonical morphism",
  StyleBox[" ",
    FontSlant->"Italic"],
  " "
}], "Text"],

Cell[BoxData[
    FormBox[
      RowBox[{
        RowBox[{\(F\_B\), 
          RowBox[{
            SubscriptBox[
              StyleBox["\[CapitalPi]",
                FontSlant->"Plain"], "p"], "\[LongRightArrow]", 
            SubscriptBox[
              StyleBox["\[CapitalPi]",
                FontSlant->"Plain"], \(F\ p\)]}], \(F\_E\)}], "   ", ","}], 
      TraditionalForm]], "EquationNumbered"],

Cell["\<\
obtained as the mate of the inverse of the canonical isomorphism \
\
\>", "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\(\(F\_E\ \(p\^\[Star]\)\[LongRightArrow]\(\((F\ \
p)\)\^\[Star]\)\ F\_B\)\(,\)\)\)], "EquationNumbered"],

Cell["is invertible.", "TextContinuation"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Example ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "ExampleLabel",
    TaggingRules:>{"CellLabel" -> True}],
  ""
}], "Example",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Example-429143541"],

Cell[TextData[{
  "When ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is a category of sets, or more generally a topos, every morphism is \
powerful. A category in which each morphism is powerful is called ",
  StyleBox["internally complete",
    FontSlant->"Italic"],
  " (or \[OpenCurlyDoubleQuote]locally cartesian closed\
\[CloseCurlyDoubleQuote]",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[8]",
    ButtonData:>"Penon73",
    ButtonStyle->"Citation",
    ButtonNote->"Penon73"],
  " or \[OpenCurlyDoubleQuote]a closed span \
category\[CloseCurlyDoubleQuote]",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[9]",
    ButtonData:>"Day74b",
    ButtonStyle->"Citation",
    ButtonNote->"Day74b"],
  ")."
}], "Item1Numbered",
  CellTags->{":bib:Day74b", ":bib:Penon73"}],

Cell[TextData[{
  "When ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " is a category ",
  Cell[BoxData[
      FormBox[
        StyleBox["Cat",
          FontWeight->"Bold"], TraditionalForm]]],
  " of categories, the powerful morphisms have been identified by Giraud",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[10]",
    ButtonData:>"Giraud64",
    ButtonStyle->"Citation",
    ButtonNote->"Giraud64"],
  " and Conduch\[EAcute]",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[11]",
    ButtonData:>"Cond",
    ButtonStyle->"Citation",
    ButtonNote->"Cond"],
  " (also see",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[3]",
    ButtonData:>"JohnstnTT",
    ButtonStyle->"Citation",
    ButtonNote->"JohnstnTT"],
  " and ",
  StyleBox["\[InvisibleSpace]", "RefSep"],
  ButtonBox["[12]",
    ButtonData:>"Stpfl",
    ButtonStyle->"Citation",
    ButtonNote->"Stpfl"],
  "). Moreover, the simplicial nerve functor ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{"N", ":", 
            StyleBox["Cat",
              FontWeight->"Bold"]}], "\[Rule]", 
          StyleBox[
            OverscriptBox[
              StyleBox["\[CapitalDelta]",
                FontWeight->"Bold"], "^"],
            FontWeight->"Bold"]}], TraditionalForm]]],
  " preserves internal ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  "-products for all powerful functors ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " (we leave this as an exercise using the references; however, see ",
  "Corollary ",
  ButtonBox[
  CounterBox["Section", "XRef-Corollary-51818382"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Corollary-51818382"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Corollary-51818382"], "Nil"],
  "\[InvisibleSpace]",
  "). "
}], "Item1Numbered",
  CellTags->{":bib:Cond", ":bib:Giraud64", ":bib:JohnstnTT", ":bib:Stpfl"}]
}, Open  ]],

Cell["", "Text"],

Cell[CellGroupData[{

Cell[TextData[{
  Cell[TextData[{
    "Proposition ",
    
    CounterBox["Section"],
    ".",
    
    CounterBox["Theorem"],
    ". "
  }], "PropositionLabel",
    TaggingRules:>{"CellLabel" -> True}],
  "Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`S \[LeftTee] \(T : \[ScriptCapitalE]\) \[Rule] \
\[ScriptCapitalX]\)]],
  " is an adjunction between finitely complete categories and let ",
  Cell[BoxData[
      \(TraditionalForm\`\[CurlyEpsilon] : S\ T \[Implies] 1\)]],
  " denote the counit. Suppose ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`T\ \(p : T\ E\) \[Rule] T\ B\)]],
  " in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalX]\)]],
  " are powerful. If ",
  Cell[BoxData[
      \(TraditionalForm\`S\)]],
  " preserves pullbacks along ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  " and the following square is a pullback then ",
  Cell[BoxData[
      \(TraditionalForm\`T\)]],
  " preserves internal ",
  Cell[BoxData[
      \(TraditionalForm\`p\)]],
  "-products."
}], "Proposition",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    True}}},
  ParagraphIndent->0,
  CounterIncrements->"Theorem",
  CellTags->"XRef-Proposition-518185647"],

Cell[BoxData[
    FormBox[GridBox[{
          {\(S\ T\ E\), \(\[LongRightArrow]\&\(S\ T\ p\)\), \(S\ T\ B\)},
          {\(\(\[InvisiblePrefixScriptBase]\^\[CurlyEpsilon]\_E\)\[DownArrow]\
\), "=", \(\[DownArrow]\^\[CurlyEpsilon]\_B\)},
          {"E", \(\[LongRightArrow]\+p\), "B"}
          }], TraditionalForm]], "Equation",
  CellGroupingRules->"GraphicsGrouping",
  TaggingRules:>{"ExtraConversionRules" -> {"General" -> {"RestartList" -> 
    False}}}]
}, Open  ]],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " We are required to prove that ",
  Cell[BoxData[
      FormBox[
        RowBox[{\(T\_B\), 
          RowBox[{
            SubscriptBox[
              StyleBox["\[CapitalPi]",
                FontSlant->"Plain"], "p"], "\[LongRightArrow]", 
            SubscriptBox[
              StyleBox["\[CapitalPi]",
                FontSlant->"Plain"], \(T\ p\)]}], \(T\_E\)}], 
        TraditionalForm]]],
  " is invertible. That is, we must show that, for all ",
  Cell[BoxData[
      \(TraditionalForm\`f : X \[Rule] T\ B\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`g : Y \[Rule] E\)]],
  ", the canonical "
}], "TextContinuation"],

