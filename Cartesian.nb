  CellTags->"XRef-Proposition-59104219"],

Cell[TextData[{
  StyleBox["Proof.",
    FontSlant->"Italic"],
  " ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^\(B\^op\)\)]],
  " is monadic over ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\_\(\(/\)\(B\_0\)\)\)]],
  ", and the functor underlying the monad is the composite"
}], "TextContinuation"],

Cell[BoxData[
    \(TraditionalForm\`\(\(\(\[ScriptCapitalE]\_\(\(/\)\(B\_0\)\)\(\
\[LongRightArrow]\&\(d\_1\^\[Star]\)\)\[ScriptCapitalE]\_\(\(/\)\(B\_1\)\)\)\(\
\[LongRightArrow]\&\(\[CapitalSigma]\_\(d\_0\)\)\)\[ScriptCapitalE]\_\(\(/\)\(\
B\_0\)\)\)\(.\)\)\)], "EquationNumbered"],

Cell[TextData[{
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is amenable this functor has a right adjoint and so preserves colimits. \
So ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^\(B\^op\)\)]],
  " has whatever colimits ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " has.    ",
  StyleBox["\[EmptySquare]", "QED"]
}], "TextContinuation"],

Cell["", "Text"],

Cell[TextData[{
  "Let ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\^\(B\^op\)\)]],
  " denote the sub-2-category of ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\_\(\(/\)\(B\)\)\)]],
  " consisting of the split fibrations into ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " and split-cartesian morphisms between them. The inclusion 2-functor ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\^\(B\^op\)\)]],
  "\[Rule]",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\_\(\(/\)\(B\)\)\)]],
  "  is monadic and its left adjoint takes ",
  Cell[BoxData[
      \(TraditionalForm\`f : A \[Rule] B\)]],
  " to ",
  Cell[BoxData[
      \(TraditionalForm\`\(d\_0\) : \((B/f)\) \[Rule] B\)]],
  ". Recall (see Theorem 4.13 of ",
  ButtonBox["[16]",
    ButtonData:>{"H^1.nb", ":bib:St80b"},
    ButtonStyle->"RefReturnLink"],
  ") that there is an equivalence of 2-categories  "
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\[ScriptCapitalK]\^\(B\^op\) \[TildeEqual] \(\(Cat(\
\[ScriptCapitalE]\^\(B\^op\))\)\(\ \)\(.\)\)\)], "EquationNumbered",
  CellTags->"XRef-Equation-5911456"],

Cell[TextData[{
  "We identify ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^\(B\^op\)\)]],
  " with the sub-2-category of ",
  Cell[BoxData[
      FormBox[
        FormBox[\(\[ScriptCapitalK]\^\(B\^op\)\),
          "TraditionalForm"], TraditionalForm]]],
  " consisting of the discrete objects."
}], "TextContinuation"],

Cell[TextData[{
  "If ",
  Cell[BoxData[
      \(TraditionalForm\`B\)]],
  " is amenable, it follows from Proposition ",
  ButtonBox[
  CounterBox["Section", "XRef-Proposition-59104219"],
    ButtonData:>{"Counter" -> "Theorem", "CounterTag" -> 
      "XRef-Proposition-59104219"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["Theorem", "XRef-Proposition-59104219"], "Nil"],
  "\[InvisibleSpace] that we can apply the copnstruction of ",
  ButtonBox[
  CounterBox["Section", "XRef-Equation-59104320"],
    ButtonData:>{"Counter" -> "EquationNumbered", "CounterTag" -> 
      "XRef-Equation-59104320"},
    ButtonStyle->"XRef"],
  StyleBox[".", "Nil"],
  StyleBox[
  CounterBox["EquationNumbered", "XRef-Equation-59104320"], "Nil"],
  StyleBox[" to ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\^\(B\^op\)\)]],
  " ",
  StyleBox["and ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\^\(B\^op\)\)]],
  " ",
  StyleBox["in place of ", "Nil"],
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalE]\)]],
  " and ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\)]],
  ".",
  StyleBox[" This yields a left adjoint", "Nil"],
  "\[InvisibleSpace]"
}], "Text"],

Cell[BoxData[
    \(TraditionalForm\`\(\[Pi]\_\(0  
            B\)\) : \[ScriptCapitalK]\^\(B\^op\)\[LongRightArrow]\
\[ScriptCapitalE]\^\(B\^op\)\)], "EquationNumbered",
  CellTags->"XRef-Equation-5911513"],

Cell["to the inclusion 2-functor defined by the coidentifier", \
"TextContinuation"],

Cell[BoxData[
    FormBox[
      RowBox[{
        SuperscriptBox[\((E, p)\), 
          StyleBox["2",
            FontWeight->"Bold"]], GridBox[{
            {\(\[LongRightArrow]\&\(d\_0\)\)},
            {\(\[DoubleDownArrow]\^\[Lambda]\)},
            {\(\[LongRightArrow]\+\(d\_1\)\)}
            }], \(E\[LongRightArrow]\(\(\[Pi]\_\(0  B\)\)(E)\)\)}], 
      TraditionalForm]], "EquationNumbered"],

Cell[TextData[{
  "for each split fibration ",
  Cell[BoxData[
      \(TraditionalForm\`p : E \[Rule] B\)]],
  ", where ",
  Cell[BoxData[
      FormBox[
        SuperscriptBox[\((E, p)\), 
          StyleBox["2",
            FontWeight->"Bold"]], TraditionalForm]]],
  " denotes the cotensor in ",
  Cell[BoxData[
      \(TraditionalForm\`\[ScriptCapitalK]\_\(\(/\)\(B\)\)\)]],
  "constructed by pulling back ",
  Cell[BoxData[
      FormBox[
        RowBox[{
          RowBox[{
            SuperscriptBox["p", 
              StyleBox["2",
                FontWeight->"Bold"]], ":", 
